# Backend base URL for the FastAPI service.
# Leave empty in development — the Vite dev server proxies API calls to localhost:8000.
# Set this in production to the deployed backend URL (e.g. https://api.your-domain.com).
VITE_API_BASE_URL=

# CesiumJS ion access token (optional).
# Layer 6 works without a token using a basic tokenless Cesium globe.
# To enable Bing Maps imagery and Cesium terrain, obtain a free token
# at https://ion.cesium.com/tokens and set it here.
# The real .env file is git-ignored and must never be committed.
VITE_CESIUM_ION_TOKEN=
